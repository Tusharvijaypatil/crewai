# ============================================================================
# Nimbus Support Triage Crew — environment configuration
# Copy to `.env` and fill in. NEVER commit your real `.env`.
# Everything below has a working default EXCEPT real OpenAI calls, which need
# OPENAI_API_KEY. With LLM_PROVIDER=mock (the default) the whole app runs with
# ZERO keys and ZERO cost.
# ============================================================================

# ---------------------------------------------------------------------------
# LLM PROVIDER
#   mock   -> canned structured responses, no network, no cost (DEFAULT)
#   openai -> real OpenAI API calls (requires OPENAI_API_KEY)
# ---------------------------------------------------------------------------
LLM_PROVIDER=mock

# Required only when LLM_PROVIDER=openai
OPENAI_API_KEY=

# Cheap model for classification; stronger model for drafting + QA.
CLASSIFIER_MODEL=gpt-4.1-nano
DRAFTER_MODEL=gpt-4.1-mini

# Hard cost guardrails — keep these small.
CLASSIFIER_MAX_TOKENS=300
DRAFTER_MAX_TOKENS=700
QA_MAX_TOKENS=500
LLM_TEMPERATURE=0.1
LLM_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# EMBEDDINGS — local only, no cost, offline. (Not configurable to OpenAI by design.)
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---------------------------------------------------------------------------
# VECTOR STORE
#   chroma   -> local on-disk, no keys (DEFAULT)
#   pinecone -> requires PINECONE_API_KEY + PINECONE_INDEX
# ---------------------------------------------------------------------------
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=.chroma
CHROMA_COLLECTION=nimbus_kb
RETRIEVAL_TOP_K=4

# Pinecone (only when VECTOR_STORE=pinecone)
PINECONE_API_KEY=
PINECONE_INDEX=nimbus-kb
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ---------------------------------------------------------------------------
# STORAGE — SQLite by default. Override with any SQLAlchemy URL (e.g. Postgres).
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./nimbus.sqlite3

# ---------------------------------------------------------------------------
# ROUTING (deterministic, human-in-the-loop gate)
# ---------------------------------------------------------------------------
CONFIDENCE_THRESHOLD=75

# ---------------------------------------------------------------------------
# KNOWLEDGE BASE SOURCE
# ---------------------------------------------------------------------------
KNOWLEDGE_BASE_DIR=data/knowledge_base

# ---------------------------------------------------------------------------
# OBSERVABILITY (Langfuse) — optional. Tracing activates ONLY if both keys set.
# ---------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------------------------------------------------------------------------
# APP
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
